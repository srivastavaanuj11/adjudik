# Development image for the Python services (server, workers, beat).
# The repo is bind-mounted at /app and `uv sync` runs on container start, so code
# edits are picked up live. The production multi-stage Dockerfile arrives in M4.
FROM python:3.12-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    UV_PROJECT_ENVIRONMENT=/opt/venv \
    PATH="/opt/venv/bin:/root/.local/bin:$PATH"

# Build deps for psycopg/cryptography wheels fall back; keep the image small.
RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential libpq-dev curl \
    && rm -rf /var/lib/apt/lists/*

# Install uv.
COPY --from=ghcr.io/astral-sh/uv:0.13.7 /uv /uvx /bin/

WORKDIR /app
