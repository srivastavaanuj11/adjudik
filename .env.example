# Adjudik development environment.
# Copy to .env (`make setup` does this if .env is missing). These are DEV values
# only; never reuse them in production.

# --- Django ---
DJANGO_SETTINGS_MODULE=adjudik_server.settings.dev
DJANGO_SECRET_KEY=dev-insecure-secret-key-change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,server

# --- Database (SPEC §10.3) ---
# App role for the running server/workers; owner role for migrate + tests.
DATABASE_URL=postgres://adjudik_app:adjudik_app_pw@db:5432/adjudik
DATABASE_OWNER_URL=postgres://adjudik_owner:adjudik_owner_pw@db:5432/adjudik
POSTGRES_DB=adjudik
POSTGRES_APP_PASSWORD=adjudik_app_pw
POSTGRES_OWNER_PASSWORD=adjudik_owner_pw

# --- Redis ---
REDIS_PASSWORD=dev-redis-pw
REDIS_URL=redis://:dev-redis-pw@redis:6379/0

# --- Crypto / audit (SPEC §9.5, §15.3) ---
# Fernet key(s), newest first, comma-separated. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ADJUDIK_ENCRYPTION_KEYS=dev-fernet-key-REPLACE_WITH_GENERATED
# Ed25519 signing key for audit checkpoints (dev placeholder; unset disables signing).
ADJUDIK_AUDIT_SIGNING_KEY=
ADJUDIK_AUDIT_ANCHOR_URL=

# --- Providers (SPEC §7.2) ---
# JSON map of provider name -> config. Unset falls back to the §7.2 defaults
# (includes the keyless `demo` provider).
ADJUDIK_PROVIDERS=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- Behaviour / limits ---
ADJUDIK_DEFAULT_WAIT_MS=10000
ADJUDIK_MAX_WAITERS_PER_PROCESS=64
ADJUDIK_EVAL_RATE=1200/min
ADJUDIK_WORKSPACE_EVAL_RATE=3000/min
ADJUDIK_PROVIDER_CONCURRENCY=16
ADJUDIK_INPUT_RETENTION_DAYS=365
ADJUDIK_EXPLANATION_RETENTION_DAYS=2555
ADJUDIK_STORE_PROMPTS=true
ADJUDIK_ALLOW_PRIVATE_WEBHOOKS=true
ADJUDIK_ALLOW_INSECURE_WEBHOOKS=false

# --- Bootstrap / CLI ---
ADJUDIK_BOOTSTRAP_PASSWORD=
ADJUDIK_API_KEY=
ADJUDIK_SERVER=
