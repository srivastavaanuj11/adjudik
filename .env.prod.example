# Adjudik production-shaped environment (SPEC §16.2). Copy to .env.prod and
# replace EVERY secret. The server refuses to start if any §15.7 check fails.

DJANGO_SETTINGS_MODULE=adjudik_server.settings.prod
# Generate: python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=REPLACE_WITH_A_LONG_RANDOM_SECRET
DJANGO_DEBUG=false
# Must not contain '*' (SPEC §15.7). Set to your real host(s).
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,server

# Postgres superuser (compose `db` service only).
POSTGRES_DB=adjudik
POSTGRES_SUPER_PASSWORD=REPLACE_WITH_A_STRONG_SUPERUSER_PASSWORD

# Runtime connects as the least-privilege app role; migrate uses the owner role.
# These match scripts/db-init.sql; change the script and these together for a
# real deployment (and do not grant the owner CREATEDB).
DATABASE_URL=postgres://adjudik_app:adjudik_app_pw@db:5432/adjudik
DATABASE_OWNER_URL=postgres://adjudik_owner:adjudik_owner_pw@db:5432/adjudik

# Redis URL must include a password (SPEC §15.7).
REDIS_PASSWORD=REPLACE_WITH_A_STRONG_REDIS_PASSWORD
REDIS_URL=redis://:REPLACE_WITH_A_STRONG_REDIS_PASSWORD@redis:6379/0

# Fernet key(s), newest first. Generate:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ADJUDIK_ENCRYPTION_KEYS=REPLACE_WITH_A_FERNET_KEY
# Ed25519 audit signing key (base64 of the raw 32-byte key). Generate:
#   python -c "from adjudik_core.audit_chain import generate_signing_key; print(generate_signing_key()[0])"
ADJUDIK_AUDIT_SIGNING_KEY=REPLACE_WITH_A_BASE64_ED25519_KEY
ADJUDIK_AUDIT_ANCHOR_URL=

# Providers: unset falls back to the §7.2 defaults (keyless `demo` provider).
ADJUDIK_PROVIDERS=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# SSRF guards must stay OFF in production (SPEC §15.7).
ADJUDIK_ALLOW_PRIVATE_WEBHOOKS=false
ADJUDIK_ALLOW_INSECURE_WEBHOOKS=false

# Behaviour / limits (SPEC §16.3 defaults).
ADJUDIK_DEFAULT_WAIT_MS=10000
ADJUDIK_MAX_WAITERS_PER_PROCESS=64
ADJUDIK_EVAL_RATE=1200/min
ADJUDIK_WORKSPACE_EVAL_RATE=3000/min
ADJUDIK_PROVIDER_CONCURRENCY=16
ADJUDIK_INPUT_RETENTION_DAYS=365
ADJUDIK_EXPLANATION_RETENTION_DAYS=2555
ADJUDIK_STORE_PROMPTS=true
